# Copy this file to .env.local and fill in the values. Never place real secrets here.
# The same variables must also be added in Vercel → Project → Settings → Environment Variables.

# Supabase → Connect → Connection string → "Transaction pooler" (port 6543).
# Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=

# Google Cloud Console → Google Auth Platform → Clients → your Web client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Random string (32+ characters) used to sign the login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Mailgun → sandbox domain and API key
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=
# Only needed if your Mailgun account is in the EU region:
# MAILGUN_API_BASE=https://api.eu.mailgun.net

# Your site address (use the Vercel URL in production). Used for links in emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
