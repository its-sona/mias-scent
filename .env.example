# Copy this file to .env.local and fill in the values. Never place real secrets here.
# The same variables must also be added in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API Keys / Data API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret! Server-only. Used to save orders after the server checks the user and prices.
SUPABASE_SERVICE_ROLE_KEY=

# Mailgun → sandbox domain and API key
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=
# Only needed if your Mailgun account is in the EU region:
# MAILGUN_API_BASE=https://api.eu.mailgun.net

# Your site address (use the Vercel URL in production). Used for links in emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
